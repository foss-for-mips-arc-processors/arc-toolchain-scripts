def get_nsim_opts(cpu_name):
    if cpu_name not in nsim_opts:
        raise RuntimeError("unsupported CPU %r for nSIM" % cpu_name)
    return " ".join(nsim_opts[cpu_name])


def get_arc_cpu_name(path):
    try:
        f = open(path, "rb")
    except OSError as e:
        raise RuntimeError("cannot open %s: %s" % (path, e.strerror))

    with f:
        try:
            elffile = elftools.elf.elffile.ELFFile(f)
        except elftools.common.exceptions.ELFError:
            raise RuntimeError("%s is not ELF file!" % path)

        sec = elffile.get_section_by_name(".ARC.attributes")
        if not sec:
            raise RuntimeError(".ARC.attributes section not found")
        data = sec.data()

    for i, b in enumerate(data):
        if b == 0x07:  # Tag_ARC_CPU_name
            # Extract following null-terminated string
            j = i + 1
            while j < len(data) and data[j] != 0:
                j += 1
            return data[i + 1:j].decode()

    raise RuntimeError("CPU name not found")


def main(argv):
    if len(argv) < 2:
        sys.stderr.write("usage: %s ELF-FILE [NSIMDRV-ARGS...]\n" % os.path.basename(argv[0]))
        return 1

    try:
        cpu_name = get_arc_cpu_name(argv[1])
        opts = get_nsim_opts(cpu_name)
    except RuntimeError as e:
        sys.stderr.write("%s: %s\n" % (os.path.basename(argv[0]), e))
        return 1

    cmd = ["nsimdrv"] + NSIM_COMMON_OPTS + shlex.split(opts) + argv[1:]

    if os.environ.get("NSIM_RUN_DRY"):
        print(" ".join(shlex.quote(a) for a in cmd))
        return 0

    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        sys.stderr.write("%s: cannot execute %s: %s\n" % (os.path.basename(argv[0]), cmd[0], e.strerror))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
