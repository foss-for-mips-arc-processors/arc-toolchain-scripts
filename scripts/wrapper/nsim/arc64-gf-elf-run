#!/usr/bin/env python3
"""Run an ARC ELF file on nSIM.

Detects the ARC CPU from the .ARC.attributes section of the ELF file given as
the first argument, selects the matching nSIM ISA options, and execs nsimdrv
with all of the arguments passed through.

Set NSIM_RUN_DRY=1 to print the nsimdrv command line instead of running it.
"""

